#!/bin/bash
# Function: my-claude-sync-check
# Purpose: Check if ~/.claude repository has updates and sync status (non-blocking with cache)
# Usage: my-claude-sync-check [--force]
# Platform: Mac
# Dependencies: git, my-git-status-cache

CLAUDE_DIR="$HOME/.claude"

my_claude_sync_check() {
    # Check if .claude directory exists and is a git repo
    if [[ ! -d "$CLAUDE_DIR/.git" ]]; then
        return 0
    fi

    local force=false
    [[ "$1" == "--force" ]] && force=true

    # Get cached status (instant) - spawns background update if stale
    local status
    if [[ "$force" == true ]]; then
        my-git-status-cache update claude "$CLAUDE_DIR"
        status=$(my-git-status-cache read claude)
    else
        status=$(my-git-status-cache check claude "$CLAUDE_DIR")
    fi

    # Only prompt if action needed AND we have a TTY
    case "$status" in
        pull_available)
            if [[ -t 0 ]]; then
                # Interactive: prompt user
                echo -e "\033[33m[Claude Config]\033[0m Updates available from remote"
                read -e -p "Pull latest Claude config? [y/N]: " -r REPLY
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    echo "Pulling Claude config updates..."
                    git -C "$CLAUDE_DIR" pull
                    # Refresh cache after pull
                    my-git-status-cache update claude "$CLAUDE_DIR" &>/dev/null &
                fi
            fi
            # Non-interactive: silent (MOTD will show status)
            ;;
        push_needed)
            if [[ -t 0 ]]; then
                # Interactive: prompt user
                echo -e "\033[33m[Claude Config]\033[0m Local changes not pushed"
                read -e -p "Push local Claude config changes? [y/N]: " -r REPLY
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    echo "Pushing Claude config..."
                    git -C "$CLAUDE_DIR" add -A && git -C "$CLAUDE_DIR" commit -m "Sync Claude config" && git -C "$CLAUDE_DIR" push
                    # Refresh cache after push
                    my-git-status-cache update claude "$CLAUDE_DIR" &>/dev/null &
                fi
            fi
            # Non-interactive: silent (MOTD will show status)
            ;;
        diverged)
            echo -e "\033[31m[Claude Config]\033[0m Local and remote have diverged - manual sync required"
            ;;
        # up_to_date, uncached, no_upstream - silent
    esac
}

# Execute if called directly (not sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    my_claude_sync_check "$@"
fi