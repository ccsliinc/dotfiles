#!/bin/bash
# Function: my-update-mac
# Purpose: Comprehensive macOS system update (Homebrew, npm, composer, App Store) with LLM analysis
# Usage: my-update-mac [options]
# Platform: macOS (requires Homebrew, npm, composer, mas)
# Dependencies: brew, npm, composer, mas, afm-cli (Apple on-device model, optional for analysis)
# Version: 2.5
# Changelog (2.5):
#   - npm: prune leftover @anthropic-ai/.claude-code-* staging dirs that abort
#     `npm update -g` with EINVALIDPACKAGENAME (was failing every run)
#   - Cellar permission fix now blanket-chowns /opt/homebrew/Cellar (was php-only),
#     eliminating brew cleanup "Permission denied" on nginx/other kegs
#   - Unlinked kegs surfaced in the end-of-run summary with the brew link fix
# Changelog (2.4):
#   - export HOMEBREW_ACCEPT_EULA=Y before brew upgrade so vendor EULA prompts
#     (e.g. Microsoft msodbcsql) auto-accept instead of silently hanging the run
# Changelog (2.3):
#   - LLM summary now uses Apple's on-device Foundation model via afm-cli
#     (Ollama + the `llm` dependency removed). Log is pre-reduced to fit the
#     4096-token on-device context cap. On failure: warns, no fallback, dumps raw log.
# Changelog (2.2):
#   - composer global update now runs --no-interaction so an expired GitHub
#     token can never hang the run at an auth prompt (warns + moves on instead)
# Changelog (2.1):
#   - Backup dirs auto-created; per-backup success/failure visible
#   - Timestamp now bumped only on success (failures retry next run)
#   - pipefail + failure counter + conditional success/warning banner
#   - Gogs remote (10.0.10.70 IP) verification; pushes current branch explicitly
#   - Colored section headers; mas/brew/npm "none" messages; sudo warning
#   - LLM-down fallback prints raw log; TTY-guarded confirm prompt
#   - Removed dead Atom apm block
#   - NEW: Composer GitHub token pre-flight check
#   - NEW: macOS system update listing (softwareupdate -l, list-only)
#   - NEW: deterministic end-of-run change summary

my_update_mac() {
    set -o pipefail
    local SCRIPT_NAME=$(basename "$0")
    local VERSION='2.5'

    # Configuration
    local force_update=false
    local no_analyze=false
    local analyze_only=false
    local update_file="$HOME/.update_brew"
    local output_file="$HOME/.update_mac_output.log"
    local current=$(date +%s)
    local time_threshold=345600  # 4 days in seconds

    # Quiet Homebrew's noise for self-updating apps:
    # - self-updating casks (Chrome, Slack, VS Code, VLC, iTerm2, etc.) update themselves,
    #   so skip them instead of emitting "cannot be upgraded as-is" warnings every run.
    # - drop the "Hide these hints"/greedy-cask env hints.
    export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1
    export HOMEBREW_NO_ENV_HINTS=1

    # Colors
    local RED='\033[0;31m'
    local GREEN='\033[0;32m'
    local YELLOW='\033[1;33m'
    local CYAN='\033[0;36m'
    local BOLD='\033[1m'
    local NC='\033[0m'

    # Function to display usage
    usage() {
        cat << EOF
Usage: $SCRIPT_NAME [OPTIONS]

Comprehensive macOS system update with optional LLM analysis.

OPTIONS:
    -f, --force         Force update regardless of last update time
    --no-analyze        Skip LLM analysis after update
    --analyze-only      Re-analyze last update output (skip running update)
    -h, --help          Display this help message
    -v, --version       Display version information

WHAT IT DOES:
    1. Backs up system settings to iCloud
    2. Updates Homebrew packages
    3. Fixes PHP permissions (if needed)
    4. Runs brew diagnostics
    5. Updates npm and Composer packages
    6. Shows available App Store updates
    7. Analyzes output with LLM (if available)

EXAMPLES:
    $SCRIPT_NAME                  # Normal update with LLM analysis
    $SCRIPT_NAME --force          # Force update now
    $SCRIPT_NAME --no-analyze     # Update without LLM analysis
    $SCRIPT_NAME --analyze-only   # Re-analyze last update output

EOF
    }

    # Check if Apple's on-device model CLI is available
    has_afm() {
        command -v afm-cli &>/dev/null
    }

    # Run LLM analysis on output
    run_llm_analysis() {
        if [[ ! -f "$output_file" ]]; then
            echo -e "${RED}No update output found to analyze${NC}"
            return 1
        fi

        if ! has_afm; then
            echo -e "${YELLOW}⚠️  afm-cli not installed — cannot summarize via Apple's on-device model.${NC}"
            echo -e "${YELLOW}    Install: brew install CreevekCZ/tap/afm-cli  (needs Apple Intelligence enabled)${NC}"
            echo -e "${YELLOW}Showing raw update log instead:${NC}"
            tail -60 "$output_file"
            return 1
        fi

        # Separator so the summary appends below the live log (no screen clear)
        echo ""
        echo -e "${CYAN}───────────────────────────────────────────────────────────${NC}"
        echo "(full live log above; raw log at $output_file)"

        echo ""
        echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════${NC}"
        echo -e "${BOLD}${CYAN}                   UPDATE ANALYSIS${NC}"
        echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════${NC}"
        echo ""

        # LLM prompt for analysis
        local prompt='Analyze this macOS system update output. Use these EXACT escape codes for terminal colors:
\033[1;32m = green (success)
\033[1;33m = yellow (warning/pending)
\033[1;31m = red (error)
\033[1;36m = cyan (info)
\033[0m = reset

Format your response with these sections:

## Backups
Show status of each backup (hosts, Brewfile, npm list, composer list). Example:
\033[1;32m✓\033[0m Brewfile backed up to iCloud

## Homebrew
List packages updated with version changes. If none updated, say "All packages up to date". Example:
\033[1;32m✓\033[0m opencv 4.12.0 → 4.13.0

## NPM
Status: updated X packages, up to date, or failed with reason

## Composer
Status: updated X packages, up to date, or failed with reason

## App Store
List available updates (these are informational, not errors). Example:
\033[1;36mℹ\033[0m BBEdit 15.5.3 → 15.5.4 available (run: mas upgrade)

## Warnings
Only show actual problems like deprecated packages or errors. Do NOT list available updates here.

## Suggested Fixes
For each warning/error, provide a specific fix command. Be specific - look up what replaces deprecated packages.

Keep it concise. Use the color codes exactly as shown - they will be interpreted by the terminal.'

        # Run analysis via Apple's on-device Foundation model (afm-cli)
        echo -e "${YELLOW}Analyzing update output (Apple on-device model)...${NC}"
        echo ""

        # Analysis summary file
        local summary_file="$HOME/.update_mac_summary.txt"

        # The on-device model is hard-capped at 4096 tokens (input+output combined).
        # The raw log is far too big, so pre-reduce to the meaningful lines only:
        # section headers, per-item ✓/✗/-, warnings/errors, version arrows, summary.
        local reduced
        reduced=$(grep -iE '^##|^  ✓|^  ✗|^  -|warning|error|deprecat|outdated|expired|unlinked|→|completed (successfully|with)|Updated at' "$output_file" | head -200)
        # Sanitize before sending to Apple's on-device model: strip ANSI color codes
        # and drop non-ASCII (emoji 🍺, box-drawing, arrows →). FoundationModels rejects
        # such input with "unsupported language or locale" (error 4) — this was the sole
        # reason the analysis step failed. LC_ALL=C makes tr operate byte-wise.
        reduced=$(printf '%s\n' "$reduced" \
            | sed $'s/\x1b\\[[0-9;]*m//g' \
            | LC_ALL=C tr -cd '[:print:]\t\n' \
            | head -c 10000)

        # Format prompt as system prompt; reduced log piped in as stdin
        local llm_result
        llm_result=$(printf '%s\n' "$reduced" | afm-cli --system-prompt "$prompt" 2>&1)
        local llm_exit=$?

        # Warn (no fallback, by design) on failure — show raw log so nothing is lost
        if [[ $llm_exit -ne 0 ]] || [[ -z "$llm_result" ]]; then
            echo -e "${RED}⚠️  Apple on-device model failed (exit $llm_exit). No fallback configured.${NC}"
            echo -e "${YELLOW}    Check: Apple Intelligence enabled (Settings); model may be busy/initializing.${NC}"
            echo -e "${YELLOW}Showing raw update log instead:${NC}"
            tail -80 "$output_file"
            return 1
        fi

        # Save and display
        echo "$llm_result" > "$summary_file"
        printf '%b\n' "$llm_result"

        echo ""
        echo -e "${CYAN}───────────────────────────────────────────────────────────${NC}"
        echo -e "Raw output: ${CYAN}$output_file${NC}"
        echo -e "Summary:    ${CYAN}$summary_file${NC}"
        echo ""
    }

    # The actual update function. Returns number of step failures via global UPDATE_FAILURES.
    run_updates() {
        # Failure tracking (deterministic recap consumes these too)
        UPDATE_FAILURES=0
        UPDATE_FAILED_STEPS=""
        BREW_OUTDATED_COUNT=0
        NPM_RESULT="not run"
        COMPOSER_RESULT="not run"
        MACOS_PENDING="unknown"
        APPSTORE_PENDING="unknown"
        UNLINKED_KEGS=""

        # Mark a major step as failed (name, ...)
        mark_failure() {
            UPDATE_FAILURES=$((UPDATE_FAILURES + 1))
            UPDATE_FAILED_STEPS="${UPDATE_FAILED_STEPS}${UPDATE_FAILED_STEPS:+, }$1"
        }

        echo "macOS System Update Starting..."
        echo "=============================="

        # Backup system settings
        echo -e "${BOLD}${CYAN}## Backing up system settings...${NC}"
        local backup_dir="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Apps"

        if [[ -d "$backup_dir" ]]; then
            # Ensure target subdirs exist (iCloud may have evicted/never-created them)
            mkdir -p "$backup_dir"/{hosts,brew,npm,composer}

            echo "Backing up hosts file..."
            if cp -f /etc/hosts "$backup_dir/hosts/"; then echo "  ✓ hosts"; else echo "  ✗ hosts failed"; fi

            echo "Backing up Homebrew bundle..."
            if brew bundle dump --force --file="$backup_dir/brew/Brewfile"; then echo "  ✓ Brewfile"; else echo "  ✗ Brewfile failed"; fi

            echo "Backing up global npm packages..."
            if npm list --global --parseable --depth=0 2>/dev/null | sed '1d' | awk '{gsub(/\/.*\//,"",$1); print}' > "$backup_dir/npm/npm.txt"; then echo "  ✓ npm list"; else echo "  ✗ npm list failed"; fi

            echo "Backing up global composer packages..."
            if command -v composer &>/dev/null; then
                if composer global show > "$backup_dir/composer/composer.txt" 2>/dev/null; then echo "  ✓ composer list"; else echo "  ✗ composer list failed"; fi
            else
                echo "  - composer not installed (skipped)"
            fi

            echo "Backing up Claude Code config to Gogs..."
            if [[ -d "$HOME/.claude/.git" ]]; then
                (
                    cd "$HOME/.claude"
                    # Verify gogs remote uses the direct IP (hostname is Authentik-blocked)
                    local gogs_url
                    gogs_url=$(git remote get-url gogs 2>/dev/null)
                    if [[ -n "$gogs_url" && "$gogs_url" != *"10.0.10.70"* ]]; then
                        echo "⚠️  gogs remote does not point at 10.0.10.70 (got: $gogs_url) — push may hit Authentik-blocked hostname gogs.home.sugamele.com"
                    fi
                    # Only commit and push if there are changes
                    if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
                        git add -A
                        git commit -m "Auto-backup $(date '+%Y-%m-%d %H:%M')" 2>/dev/null || true
                        local cur_branch
                        cur_branch=$(git branch --show-current)
                        git push gogs "$cur_branch" 2>&1 || echo "⚠️  Failed to push to Gogs - check remote: git -C ~/.claude remote -v"
                    else
                        echo "No changes to backup"
                    fi
                )
            fi
        fi

        echo ""
        echo -e "${BOLD}${CYAN}## Updating Homebrew...${NC}"
        # Auto-accept vendor EULAs (e.g. Microsoft msodbcsql) so brew upgrade never
        # hangs on a hidden interactive license prompt that doesn't flush to screen.
        export HOMEBREW_ACCEPT_EULA=Y
        echo "Fetching latest formulae (may take a minute)..."
        brew update || mark_failure "brew update"

        # Show what's outdated before upgrading
        local brew_outdated
        brew_outdated=$(brew outdated 2>/dev/null)
        if [[ -n "$brew_outdated" ]]; then
            BREW_OUTDATED_COUNT=$(printf '%s\n' "$brew_outdated" | grep -c .)
            echo "Outdated formulae ($BREW_OUTDATED_COUNT):"
            printf '%s\n' "$brew_outdated"
        else
            echo "All formulae current"
        fi
        # brew upgrade exits non-zero for BENIGN warnings (unbottled dependents like
        # camsnap, outdated Xcode) — not just real failures. Treating every non-zero as
        # a failure kept the run perpetually "failed", so the success timestamp never
        # advanced and the updater stayed frozen in the "fresh/not-needed" state forever.
        # Fix: stream live (tee) but only count a genuine "Error:" line as a failure.
        local _brew_up_log; _brew_up_log="$(mktemp)"
        brew upgrade 2>&1 | tee "$_brew_up_log"
        grep -qE "^Error:" "$_brew_up_log" && mark_failure "brew upgrade"
        rm -f "$_brew_up_log"

        # Fix Cellar permissions before cleanup. php-fpm/nginx run as root and can
        # leave root-owned files that break `brew cleanup`. Blanket-chown the whole
        # Cellar to the current user (single-user Mac; Homebrew is user-owned anyway).
        if [[ -d "/opt/homebrew/Cellar" ]]; then
            echo "→ Need sudo to fix Homebrew Cellar permissions (may prompt for password)..."
            sudo chown -R "$(whoami)" /opt/homebrew/Cellar 2>/dev/null || true
        fi

        brew cleanup -s

        echo ""
        echo -e "${BOLD}${CYAN}## Running Homebrew diagnostics...${NC}"
        local brew_doctor_out
        brew_doctor_out=$(brew doctor 2>&1)
        printf '%s\n' "$brew_doctor_out"
        # Surface unlinked kegs in the final summary (don't auto-link — let user decide)
        UNLINKED_KEGS=$(printf '%s\n' "$brew_doctor_out" | awk '/brew link.* on these/{g=1;next} g&&/^  +[^ ]/{sub(/^ +/,"");print $1;next} g&&/^[^ ]/{g=0}' | tr '\n' ' ' | sed 's/ *$//')
        local brew_missing
        brew_missing=$(brew missing 2>/dev/null)
        if [[ -n "$brew_missing" ]]; then
            printf '%s\n' "$brew_missing"
        else
            echo "No missing dependencies"
        fi

        echo ""
        echo -e "${BOLD}${CYAN}## Checking macOS system updates...${NC}"
        local sw_out
        sw_out=$(softwareupdate -l 2>&1)
        if echo "$sw_out" | grep -qi "No new software available"; then
            echo "  ✓ macOS up to date"
            MACOS_PENDING="none"
        else
            echo "$sw_out" | grep -E "\*|Title|Version" || echo "$sw_out"
            echo -e "${YELLOW}  To install: softwareupdate -i -a  (may require reboot)${NC}"
            MACOS_PENDING="pending"
        fi

        echo ""
        echo -e "${BOLD}${CYAN}## Checking App Store updates...${NC}"
        if command -v mas &> /dev/null; then
            local mas_out
            mas_out=$(mas outdated 2>/dev/null)
            if [[ -z "$mas_out" ]]; then
                echo "All App Store apps up to date"
                APPSTORE_PENDING="none"
            else
                echo "Available App Store updates:"
                printf '%s\n' "$mas_out"
                echo ""
                echo "Run 'mas upgrade' to install App Store updates"
                APPSTORE_PENDING="pending"
            fi
        else
            echo "mas not installed - install with: brew install mas"
        fi

        echo ""
        echo -e "${BOLD}${CYAN}## Updating npm packages...${NC}"
        # Prune leftover install-staging dirs (e.g. Claude Code's @anthropic-ai/.claude-code-XXXX)
        # whose dot-prefixed names make `npm update -g` abort with EINVALIDPACKAGENAME.
        rm -rf "$(npm root -g)"/@anthropic-ai/.claude-code-* 2>/dev/null
        local npm_outdated
        npm_outdated=$(npm outdated -g 2>/dev/null)
        if [[ -n "$npm_outdated" ]]; then
            echo "Outdated global npm packages:"
            printf '%s\n' "$npm_outdated"
        else
            echo "npm globals current"
        fi
        if npm update -g; then
            NPM_RESULT="ok"
            echo "  ✓ npm globals updated"
        else
            NPM_RESULT="failed"
            mark_failure "npm update"
            echo "  ✗ npm update failed"
        fi

        echo ""
        echo -e "${BOLD}${CYAN}## Checking Composer GitHub token...${NC}"
        local gh_token
        gh_token=$(composer config --global --no-interaction github-oauth.github.com 2>/dev/null)
        if [[ -n "$gh_token" ]]; then
            local gh_status
            gh_status=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: token $gh_token" https://api.github.com/user 2>/dev/null)
            if [[ "$gh_status" == "200" ]]; then
                echo "  ✓ GitHub token valid"
            elif [[ "$gh_status" == "401" ]]; then
                echo -e "${RED}  ✗ GitHub token EXPIRED/INVALID (HTTP 401)${NC}"
                echo -e "${YELLOW}  Fix: composer config --global --unset github-oauth.github.com${NC}"
                echo -e "${YELLOW}       composer config --global github-oauth.github.com YOUR_NEW_TOKEN${NC}"
                echo -e "${YELLOW}  New token: https://github.com/settings/tokens (scope: repo, read:packages)${NC}"
            else
                echo -e "${YELLOW}  ? GitHub token check inconclusive (HTTP $gh_status)${NC}"
            fi
        else
            echo "  (no composer github-oauth token configured)"
        fi

        echo ""
        echo -e "${BOLD}${CYAN}## Updating Composer packages...${NC}"
        local composer_output
        # --no-interaction: never block on an auth prompt (expired GitHub token
        # would otherwise hang the whole run indefinitely). Fails fast instead;
        # the token pre-check above already warned, giving time to regenerate.
        composer_output=$(composer global update --no-interaction 2>&1)
        local composer_exit=$?
        if [[ $composer_exit -ne 0 ]]; then
            echo "$composer_output"
            COMPOSER_RESULT="failed"
            mark_failure "composer update"
            if echo "$composer_output" | grep -qi "authentication\|token\|oauth\|unauthorized\|403"; then
                echo ""
                echo -e "⚠️  Composer authentication error detected!"
                echo "Fix with: composer config --global --unset github-oauth.github.com"
                echo "Then add new token: composer config --global github-oauth.github.com YOUR_TOKEN"
                echo "Get token at: https://github.com/settings/tokens"
            else
                echo "composer update failed (exit code: $composer_exit)"
            fi
        else
            echo "$composer_output"
            COMPOSER_RESULT="ok"
        fi

        # Deterministic ground-truth recap (LLM analysis runs separately afterward)
        echo ""
        echo -e "${BOLD}${CYAN}## Summary${NC}"
        echo "- Homebrew: $BREW_OUTDATED_COUNT formula(e) were outdated before upgrade"
        echo "- npm globals: $NPM_RESULT"
        echo "- Composer: $COMPOSER_RESULT"
        echo "- macOS system updates: $MACOS_PENDING"
        echo "- App Store updates: $APPSTORE_PENDING"
        if [[ -n "$UNLINKED_KEGS" ]]; then
            echo -e "- ${YELLOW}Unlinked kegs:${NC} $UNLINKED_KEGS  (fix: brew link $UNLINKED_KEGS)"
        fi

        echo ""
        if [[ $UPDATE_FAILURES -eq 0 ]]; then
            echo -e "${BOLD}${GREEN}## Update completed successfully!${NC}"
        else
            echo -e "${BOLD}${YELLOW}## Update completed with $UPDATE_FAILURES warning(s)/error(s): ${UPDATE_FAILED_STEPS}${NC}"
        fi
        echo "================================"
        echo "Updated at: $(date)"
        echo ""
        echo "Optional manual updates:"
        echo "- App Store: mas upgrade"
        echo "- Ruby gems: gem update --system && gem update"
        echo "- Python packages: pip list --outdated"

        return $UPDATE_FAILURES
    }

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f|--force)
                force_update=true
                shift
                ;;
            --no-analyze)
                no_analyze=true
                shift
                ;;
            --analyze-only)
                analyze_only=true
                shift
                ;;
            -h|--help)
                usage
                return 0
                ;;
            -v|--version)
                echo "$SCRIPT_NAME version $VERSION"
                return 0
                ;;
            *)
                echo "Invalid argument: $1"
                echo "Try: $SCRIPT_NAME --help"
                return 1
                ;;
        esac
    done

    # Handle analyze-only mode
    if [[ "$analyze_only" == true ]]; then
        run_llm_analysis
        return $?
    fi

    # Check if update is needed, and whether this is a stale interactive run
    # that should prompt. Capture the real last-update string now, because the
    # reservation step below overwrites the stamp before we print the prompt.
    local need_prompt=false
    local last_update_str=""
    if [[ -f "$update_file" ]]; then
        local last_modified=$(stat -f %m "$update_file")
        local time_difference=$((current - last_modified))
        last_update_str=$(stat -f "%Sm" "$update_file")

        if [[ $force_update == false && $time_difference -le $time_threshold ]]; then
            echo "Last update was $last_update_str"
            echo "Update not needed (use --force to override)"
            return 0
        fi

        [[ $force_update == false ]] && need_prompt=true
    fi

    # Claim a 1-day reservation NOW -- BEFORE any prompt -- by stamping the file to
    # (now - threshold + 1d). The first tab to reach here locks instantly, so a
    # second tab opened while this one is still prompting or running sees a
    # fresh-enough timestamp and skips silently: no duplicate prompt, no parallel
    # updaters clobbering the shared log (that combo is what broke new tabs).
    # On success we extend it to the full window; if this run is declined, fails,
    # or is killed, the short reservation makes it retry in ~1 day, not every launch.
    local reserve=$(( current - time_threshold + 86400 ))
    touch -t "$(date -r "$reserve" +%Y%m%d%H%M.%S)" "$update_file"

    # Prompt only on a stale interactive run. The reservation is already claimed,
    # so other tabs won't pile up behind this prompt.
    if [[ $need_prompt == true ]]; then
        echo "Last update: $last_update_str"
        if [[ -t 0 ]]; then
            read -p "Do you want to update? [y/N] " -n 1 -r
            echo ""
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                # Declined: keep the 1-day reservation so we ask again tomorrow, not every tab.
                return 0
            fi
        else
            echo "Non-interactive shell (no TTY) — proceeding with update automatically."
        fi
    fi

    # Run updates with tee to capture output while showing live
    echo -e "${CYAN}Starting system update...${NC}"
    echo ""

    # Clear previous output file
    > "$output_file"

    # Run updates and capture output with tee; grab run_updates' real exit, not tee's
    run_updates 2>&1 | tee "$output_file"
    local run_status=${PIPESTATUS[0]}

    # Success -> extend to the full window. Failure -> keep the 1-day reservation
    # (set above) so the next run retries tomorrow instead of every shell launch.
    if [[ $run_status -eq 0 ]]; then
        touch "$update_file"
        # Dedicated marker for the LAST REAL SUCCESSFUL update. Unlike $update_file
        # (which also carries the start-of-run reservation), this file is touched
        # ONLY on a clean success — so the MOTD "Last Update" line never shows a
        # reservation/failed-run date, only genuine completed updates.
        touch "$HOME/.update_last_success"
    else
        echo -e "${YELLOW}Update reported $run_status warning(s)/error(s) — 1-day reservation kept; retries tomorrow.${NC}"
    fi

    # Run LLM analysis if not disabled
    if [[ "$no_analyze" == false ]]; then
        # Small pause so live output flushes before the analysis section
        sleep 1
        run_llm_analysis
    fi

    return $run_status
}

# Execute if called directly (not sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    my_update_mac "$@"
fi
