# shellcheck shell=bash
if [ "$DEBUG" = "true" ]; then echo "$DOTFILESLOC/platforms/qnap/.exports" ; fi

# QNAP-specific PATH additions
# Note: base/.exports already adds base/bin, base/scripts, and platform bin/scripts
# Here we add QNAP system paths and Container Station
QNAP_PATHS="/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/opt/bin:/opt/sbin"
CONTAINER_STATION="$(getcfg SHARE_DEF defVolMP -f /etc/config/def_share.info 2>/dev/null)/.qpkg/container-station/bin"

# Prepend QNAP system paths, append Container Station
export PATH="$QNAP_PATHS:$PATH:$CONTAINER_STATION"

# QTS ships no default locale, so shells start in C and zsh cannot print
# non-ASCII ("character not in range" from the prompt's Nerd Font icons).
# en_US.utf8 is installed on the box; select it unless already set.
[ -z "$LANG" ] && export LANG=en_US.UTF-8

# .bashrc
USER=$(id -un); export USER
export LOGNAME=$USER
HOSTNAME=$(/bin/hostname); export HOSTNAME
#export HISTSIZE=1000
#export HISTFILESIZE=1000
export PAGER='/bin/more '
export EDITOR='/bin/vi'
export INPUTRC=/etc/inputrc
export DMALLOC_OPTIONS=debug=0x34f47d83,inter=100,log=logfile
