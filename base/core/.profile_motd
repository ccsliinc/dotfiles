# shellcheck shell=bash
if [ "$DEBUG" = "true" ]; then echo "$DOTFILESLOC/base/core/.profile_motd" ; fi

# shellcheck source=../shared/bash_colors.sh
source "$DOTFILESLOC/base/shared/bash_colors.sh"

# Print out some stuff
#############################
    if [ "$DEBUG" != "true" ]; then clear ; fi
    echo -en "$LBLUE"
    echo "_________________________________________________________________________"
    echo -en "$LCYAN"
    date
    echo -en "$NOCOLOR"

    if [[ -x "$(command -v fortune)" ]] ; then
        echo -en "$DPURPLE"
        echo
        fortune
        echo
    fi

    echo -en "$LGREEN"
    echo -e "Uptime: $(uptime)"
    echo -e "$NOCOLOR"


    echo -e "${LBLUE}Welcome to: ${LRED}$(hostname)${LBLUE}"
    echo -e "$NOCOLOR"
    
    echo -en "$LWHITE"
    echo -e "Model          : $MODEL"
    echo -e "OS Version     : $OS_VERSION"
    echo -e "Architecture   : $ARCH"
    echo -e "Shell          : $SHELL"
    # Last login (skip current session)
    LAST_LOGIN=$(last -2 "$USER" 2>/dev/null | sed -n '2p' | awk '{print $3, $4, $5, $6}')
    echo -e "Last Login     : ${LAST_LOGIN:-unknown}"
    # Dotfiles sync status (from cache - non-blocking)
    if [[ -d "$DOTFILESLOC/.git" ]]; then
        local dotfiles_status=$(my-git-status-cache check dotfiles "$DOTFILESLOC" 2>/dev/null)
        case "$dotfiles_status" in
            up_to_date)     DOTFILES_STATUS="${LGREEN}✓ synced${LWHITE}" ;;
            pull_available) DOTFILES_STATUS="${LYELLOW}↓ pull available${LWHITE}" ;;
            push_needed)    DOTFILES_STATUS="${LYELLOW}↑ push needed${LWHITE}" ;;
            diverged)       DOTFILES_STATUS="${LRED}⚠ diverged${LWHITE}" ;;
            *)              DOTFILES_STATUS="${DGRAY}checking...${LWHITE}" ;;
        esac
    else
        DOTFILES_STATUS="${DGRAY}not a repo${LWHITE}"
    fi
    echo -e "Dotfiles       : $DOTFILES_STATUS"
    # Claude config sync status (from cache - non-blocking)
    if [[ -d "$HOME/.claude/.git" ]]; then
        # Use cached status (spawns background check if stale)
        local claude_status=$(my-git-status-cache check claude "$HOME/.claude" 2>/dev/null)
        case "$claude_status" in
            up_to_date)    CLAUDE_STATUS="${LGREEN}✓ synced${LWHITE}" ;;
            pull_available) CLAUDE_STATUS="${LYELLOW}↓ pull available${LWHITE}" ;;
            push_needed)   CLAUDE_STATUS="${LYELLOW}↑ push needed${LWHITE}" ;;
            diverged)      CLAUDE_STATUS="${LRED}⚠ diverged${LWHITE}" ;;
            *)             CLAUDE_STATUS="${DGRAY}checking...${LWHITE}" ;;
        esac
    else
        CLAUDE_STATUS="${DGRAY}not a repo${LWHITE}"
    fi
    echo -e "Claude Config  : $CLAUDE_STATUS"
    echo -e "$LYELLOW"
    echo "Detected OS : $OS"
    echo -en "$LBLUE"
    echo "_________________________________________________________________________"
    # change color to normal
    echo -en "$NOCOLOR"
    echo