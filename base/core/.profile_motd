# shellcheck shell=bash
if [ "$DEBUG" = "true" ]; then echo "$DOTFILESLOC/base/core/.profile_motd" ; fi

# shellcheck source=../shared/bash_colors.sh
source "$DOTFILESLOC/base/shared/bash_colors.sh"

# Print out some stuff
#############################
    if [ "$DEBUG" != "true" ]; then clear ; fi
    echo -en "$LBLUE"
    echo "_________________________________________________________________________"
    echo -en "$LCYAN"
    date
    echo -en "$NOCOLOR"

    if [[ -x "$(command -v fortune)" ]] ; then
        echo -en "$DPURPLE"
        echo
        fortune
        echo
    fi

    echo -en "$LGREEN"
    echo -e "Uptime: $(uptime)"
    echo -e "$NOCOLOR"


    echo -e "${LBLUE}Welcome to: ${LRED}$(hostname)${LBLUE}"
    echo -e "$NOCOLOR"
    
    echo -en "$LWHITE"
    echo -e "Model          : $MODEL"
    echo -e "OS Version     : $OS_VERSION"
    echo -e "Architecture   : $ARCH"
    echo -e "Shell          : $SHELL"
    # Last login (skip current session)
    LAST_LOGIN=$(last -2 "$USER" 2>/dev/null | sed -n '2p' | awk '{print $3, $4, $5, $6}')
    echo -e "Last Login     : ${LAST_LOGIN:-unknown}"
    # Claude config sync status (quick check, no prompts)
    if [[ -d "$HOME/.claude/.git" ]]; then
        cd "$HOME/.claude" &>/dev/null && git remote update &>/dev/null
        CLAUDE_LOCAL=$(git rev-parse @ 2>/dev/null)
        CLAUDE_REMOTE=$(git rev-parse @{u} 2>/dev/null)
        if [[ "$CLAUDE_LOCAL" == "$CLAUDE_REMOTE" ]]; then
            CLAUDE_STATUS="${LGREEN}✓ synced${LWHITE}"
        elif [[ "$(git merge-base @ @{u} 2>/dev/null)" == "$CLAUDE_LOCAL" ]]; then
            CLAUDE_STATUS="${LYELLOW}↓ pull available${LWHITE}"
        elif [[ "$(git merge-base @ @{u} 2>/dev/null)" == "$CLAUDE_REMOTE" ]]; then
            CLAUDE_STATUS="${LYELLOW}↑ push needed${LWHITE}"
        else
            CLAUDE_STATUS="${LRED}⚠ diverged${LWHITE}"
        fi
        cd - &>/dev/null
    else
        CLAUDE_STATUS="${DGRAY}not a repo${LWHITE}"
    fi
    echo -e "Claude Config  : $CLAUDE_STATUS"
    echo -e "$LYELLOW"
    echo "Detected OS : $OS"
    echo -en "$LBLUE"
    echo "_________________________________________________________________________"
    # change color to normal
    echo -en "$NOCOLOR"
    echo