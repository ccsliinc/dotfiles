# shellcheck shell=bash
# .env_common - Shared environment setup for non-interactive shells
# ============================================================================
# Sourced by:
#   - .zshenv (for zsh non-interactive shells)
#   - BASH_ENV (for bash non-interactive shells)
#
# This ensures DOTFILESLOC, PATH, and exports are available for:
#   - Scripts run via SSH
#   - Cron jobs
#   - Non-interactive shell commands
#   - IDE terminals and tools
# ============================================================================

if [ "$DEBUG" = "true" ]; then echo "$DOTFILESLOC/base/.env_common" ; fi

# Guard against double-loading (prevents duplicate PATH entries, etc.)
[[ -n "$DOTFILES_ENV_LOADED" ]] && return 0
export DOTFILES_ENV_LOADED=1

# ============================================================================
# DOTFILES LOCATION CONFIGURATION
# ============================================================================
# Priority order:
#   1. DOTFILESLOC already set (e.g., by parent script)
#   2. ~/.dotfiles_location file (for custom install locations)
#   3. Default: ~/.dotfiles
#
# To use a custom location, create ~/.dotfiles_location containing:
#   export DOTFILESLOC="/your/custom/path"
# ============================================================================

DOTFILES_DEFAULT_LOCATION="$HOME/.dotfiles"

if [[ -n "$DOTFILESLOC" ]]; then
    # Already set externally, use it
    :
elif [[ -f "$HOME/.dotfiles_location" ]]; then
    # Custom location specified
    # shellcheck source=/dev/null
    source "$HOME/.dotfiles_location"
elif [[ -d "$DOTFILES_DEFAULT_LOCATION" ]]; then
    # Default location exists
    export DOTFILESLOC="$DOTFILES_DEFAULT_LOCATION"
else
    # Cannot find dotfiles - exit silently for non-interactive shells
    return 1 2>/dev/null || exit 1
fi

# ============================================================================
# LOAD CORE ENVIRONMENT
# ============================================================================

# Source OS detection (sets $OS for platform-specific paths)
# shellcheck source=/dev/null
[[ -f "$DOTFILESLOC/base/core/.profile_os" ]] && source "$DOTFILESLOC/base/core/.profile_os"

# Source exports (PATH, EDITOR, LS_COLORS, etc.)
# shellcheck source=/dev/null
[[ -f "$DOTFILESLOC/base/.exports" ]] && source "$DOTFILESLOC/base/.exports"
