#!/bin/bash
# Function: my-git-status-cache
# Purpose: Report a repo's sync status at login without ever blocking on the network
# Usage: my-git-status-cache [check|update|read|fetch-age] [repo_name] [repo_path]
# Platform: All (requires git)
# Dependencies: git
#
# Design note (why this is not a plain cache):
#   The status itself is derived from refs already on disk, which costs a few
#   milliseconds, so it is recomputed on every call and can never go stale.
#   What IS cached is the expensive part -- the network fetch -- and the cache
#   file records which commits the answer came from, so a wrong answer cannot
#   survive a pull, a push, or a commit the way a bare cached word could.
#
# Examples:
#   my-git-status-cache check dotfiles ~/.dotfiles    # Status now; background fetch if the last one is old
#   my-git-status-cache update dotfiles ~/.dotfiles   # Fetch first, then report (blocking, for --force)
#   my-git-status-cache read dotfiles                 # Last recorded status, no git at all

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
FETCH_MAX_AGE=${DOTFILES_CACHE_AGE:-172800}  # 2 days in seconds

mkdir -p "$CACHE_DIR" 2>/dev/null

# Description: Path of the file holding a repo's last computed status record.
# Inputs     : $1 repo_name (string)
# Outputs    : prints the path
_get_cache_file() { echo "$CACHE_DIR/${1}.status"; }

# Description: Path of the stamp file whose mtime is the last successful fetch.
# Inputs     : $1 repo_name (string)
# Outputs    : prints the path
_get_fetch_file() { echo "$CACHE_DIR/${1}.fetch"; }

# Description: Path of the lock file held while a fetch runs.
# Inputs     : $1 repo_name (string)
# Outputs    : prints the path
_get_lock_file() { echo "$CACHE_DIR/${1}.lock"; }

# Description: Seconds since a file was last written; a huge number when it does not exist.
# Inputs     : $1 file path (string)
# Outputs    : prints an integer
_file_age() {
    [[ -f "$1" ]] || { echo 999999; return; }
    local mtime
    mtime=$(stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null)
    echo $(( $(date +%s) - ${mtime:-0} ))
}

# Description: Compare local HEAD with its upstream using only refs already on disk (no network).
# Inputs     : $1 repo_path (string)
# Outputs    : prints one of up_to_date | pull_available | push_needed | diverged | no_upstream | no_repo
_compute_status() {
    local repo_path="$1"
    [[ -d "$repo_path/.git" ]] || { echo "no_repo"; return; }
    local LOCAL REMOTE BASE
    LOCAL=$(git -C "$repo_path" rev-parse @ 2>/dev/null)
    REMOTE=$(git -C "$repo_path" rev-parse @{u} 2>/dev/null)
    BASE=$(git -C "$repo_path" merge-base @ @{u} 2>/dev/null)

    if [[ -z "$LOCAL" || -z "$REMOTE" ]]; then
        echo "no_upstream"
    elif [[ "$LOCAL" == "$REMOTE" ]]; then
        echo "up_to_date"
    elif [[ "$BASE" == "$LOCAL" ]]; then
        echo "pull_available"
    elif [[ "$BASE" == "$REMOTE" ]]; then
        echo "push_needed"
    else
        echo "diverged"
    fi
}

# Description: Record a status with the commits it was derived from, so later reads are auditable.
# Inputs     : $1 repo_name (string), $2 repo_path (string), $3 status (string)
# Outputs    : writes the cache file; prints nothing
_write_status() {
    local repo_name="$1" repo_path="$2" status="$3"
    printf '%s\t%s\t%s\t%s\n' \
        "$status" \
        "$(git -C "$repo_path" rev-parse @ 2>/dev/null)" \
        "$(git -C "$repo_path" rev-parse @{u} 2>/dev/null)" \
        "$(date +%s)" > "$(_get_cache_file "$repo_name")"
}

# Description: Fetch from the remote, then recompute and record the status. Never run at login.
# Inputs     : $1 repo_name (string), $2 repo_path (string)
# Outputs    : exit 0 on a completed refresh, 2 when another fetch holds the lock, 1 when there is no repo
_update_cache() {
    local repo_name="$1" repo_path="$2"
    local lock_file; lock_file=$(_get_lock_file "$repo_name")

    # Another fetch is already running: say so rather than reporting success
    if [[ -f "$lock_file" ]] && [[ $(_file_age "$lock_file") -lt 300 ]]; then
        return 2
    fi
    rm -f "$lock_file"

    if [[ ! -d "$repo_path/.git" ]]; then
        _write_status "$repo_name" "$repo_path" "no_repo"
        return 1
    fi

    echo $$ > "$lock_file"
    if git -C "$repo_path" remote update &>/dev/null; then
        : > "$(_get_fetch_file "$repo_name")"   # stamp only a fetch that actually worked
    fi
    _write_status "$repo_name" "$repo_path" "$(_compute_status "$repo_path")"
    rm -f "$lock_file"
    return 0
}

# Description: Print the last recorded status word (first field), or "uncached".
# Inputs     : $1 repo_name (string)
# Outputs    : prints the status word
_read_cache() {
    local cache_file; cache_file=$(_get_cache_file "$1")
    [[ -f "$cache_file" ]] || { echo "uncached"; return; }
    cut -f1 "$cache_file" | head -1
}

# Description: The login path. Answers from local refs immediately and, when the last fetch is old,
#              starts one in the background -- it never waits on the network, in any shell.
# Inputs     : $1 repo_name (string), $2 repo_path (string)
# Outputs    : prints the status word
_check_and_update() {
    local repo_name="$1" repo_path="$2"
    local status; status=$(_compute_status "$repo_path")
    _write_status "$repo_name" "$repo_path" "$status"

    if [[ $(_file_age "$(_get_fetch_file "$repo_name")") -ge $FETCH_MAX_AGE ]]; then
        ( _update_cache "$repo_name" "$repo_path" >/dev/null 2>&1 & ) 2>/dev/null
    fi
    echo "$status"
}

case "${1:-check}" in
    check)  _check_and_update "${2:-dotfiles}" "${3:-$DOTFILESLOC}" ;;
    update) _update_cache "${2:-dotfiles}" "${3:-$DOTFILESLOC}" ;;
    read)   _read_cache "${2:-dotfiles}" ;;
    fetch-age) _file_age "$(_get_fetch_file "${2:-dotfiles}")" ;;
    *)
        echo "Usage: my-git-status-cache [check|update|read|fetch-age] [repo_name] [repo_path]"
        exit 1
        ;;
esac
