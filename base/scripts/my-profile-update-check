#!/bin/bash
# Function: my-profile-update-check
# Purpose: Check if dotfiles repository has updates (non-blocking with cache)
# Usage: my-profile-update-check [--force]
# Platform: All (requires git)
# Dependencies: git, my-git-status-cache

my_profile_update_check() {
    # Guard against re-running during shell restart
    if [[ -n "$DOTFILES_UPDATE_CHECKED" ]]; then
        return 0
    fi
    export DOTFILES_UPDATE_CHECKED=1

    # Verify dotfiles directory exists
    if [[ ! -d "$DOTFILESLOC/.git" ]]; then
        return 1
    fi

    local force=false
    [[ "$1" == "--force" ]] && force=true

    # Get cached status (instant) - spawns background update if stale
    local status
    if [[ "$force" == true ]]; then
        # Force: run blocking update
        my-git-status-cache update dotfiles "$DOTFILESLOC"
        status=$(my-git-status-cache read dotfiles)
    else
        # Normal: use cache, background refresh if stale
        status=$(my-git-status-cache check dotfiles "$DOTFILESLOC")
    fi

    # Only prompt if updates are available AND we have a TTY
    case "$status" in
        pull_available)
            if [[ -t 0 ]]; then
                # Interactive: prompt user
                echo "Dotfiles update available!"
                read -e -p "Do you want to update the profile? [y/N]: " -r REPLY
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    echo "Updating dotfiles..."
                    git -C "$DOTFILESLOC" pull
                    # Refresh cache after pull
                    my-git-status-cache update dotfiles "$DOTFILESLOC" &>/dev/null &
                    echo "Changes applied. Open a new terminal to use updated config."
                else
                    echo "Update skipped."
                fi
            else
                # Non-interactive (SSH/cron): just notify, don't block
                echo "[dotfiles] Update available - run 'my-profile-update-check --force' to update"
            fi
            ;;
        push_needed)
            if [[ -t 0 ]]; then
                echo "[dotfiles] Local changes need to be pushed"
                read -e -p "Push changes now? [y/N]: " -r REPLY
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    echo "Pushing dotfiles..."
                    git -C "$DOTFILESLOC" push && echo "Push successful." || echo "Push failed - check remote configuration."
                    my-git-status-cache update dotfiles "$DOTFILESLOC" &>/dev/null &
                fi
            else
                echo "[dotfiles] Local changes need to be pushed"
            fi
            ;;
        diverged)
            echo "[dotfiles] Repository has diverged from remote"
            ;;
        # up_to_date, uncached, no_upstream - silent
    esac
}

# Execute if called directly (not sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    my_profile_update_check "$@"
fi